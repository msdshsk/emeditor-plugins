// UTF-8 で保存し、code_page(65001) で rc.exe に UTF-8 であることを伝える。
// （VS のリソースエディタで開くと UTF-16 に書き換えられることがあるので、テキストとして編集する）
#pragma code_page(65001)

#include <windows.h>
#include "resource.h"
#include "version.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

// ツールバー用ビットマップ: 16x16、16 色。RGB(192,192,192) が透過色。
IDB_BITMAP              BITMAP                  "toolbar.bmp"

// プレビュー（WebView2）。読み込み時に preview.html の {{...}} を置き換える。JS はページより先に注入する
// third_party/ の marked 以外は scripts/fetch-deps.ps1 で取得する（build.ps1 が自動で呼ぶ）
IDR_PREVIEW_HTML        RCDATA                  "web\\preview.html"
IDR_MARKDOWN_CSS        RCDATA                  "..\\..\\shared\\web\\markdown.css"
IDR_MARKED_JS           RCDATA                  "..\\..\\third_party\\marked\\marked.umd.js"
IDR_FOOTNOTE_JS         RCDATA                  "..\\..\\third_party\\marked-footnote\\marked-footnote.umd.js"
IDR_HLJS_JS             RCDATA                  "..\\..\\third_party\\highlight\\highlight.min.js"
IDR_HLJS_LIGHT_CSS      RCDATA                  "..\\..\\third_party\\highlight\\github.min.css"
IDR_HLJS_DARK_CSS       RCDATA                  "..\\..\\third_party\\highlight\\github-dark.min.css"
IDR_KATEX_JS            RCDATA                  "..\\..\\third_party\\katex\\katex.min.js"
IDR_KATEX_CSS           RCDATA                  "..\\..\\third_party\\katex\\katex.inline.css"
IDR_MERMAID_JS          RCDATA                  "..\\..\\third_party\\mermaid\\mermaid.min.js"

STRINGTABLE
BEGIN
    // メニュー/ツールバー/プラグイン設定に表示される名前
    IDS_MENU_TEXT           "Markdown プレビュー"
    // ステータスバーに出る説明（80 文字まで）
    IDS_STATUS_MESSAGE      "アクティブな Markdown 文書のプレビュー（GFM）を開閉します"
    IDS_VERSION             PLUGIN_VER_STR
    IDS_SURE_TO_UNINSTALL   "このプラグインをアンインストールしますか?"
END

// カスタムバーに入れる子ダイアログ。中身は WebView2（WM_SIZE で全体に広げる）
IDD_PREVIEW DIALOGEX 0, 0, 160, 240
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 9, "Yu Gothic UI", 400, 0, 0x80
BEGIN
    LTEXT           "", IDC_MESSAGE, 8, 8, 144, 100, NOT WS_VISIBLE
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     PLUGIN_VER_MAJOR,PLUGIN_VER_MINOR,PLUGIN_VER_PATCH,0
 PRODUCTVERSION  PLUGIN_VER_MAJOR,PLUGIN_VER_MINOR,PLUGIN_VER_PATCH,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_DLL
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "FileDescription",  "EmEditor plug-in: Markdown プレビュー"
            VALUE "FileVersion",      PLUGIN_VER_STR
            VALUE "OriginalFilename", PLUGIN_FILE_NAME
            VALUE "ProductVersion",   PLUGIN_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0000, 1200
    END
END
